---
import { Image, getImage } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntrySlug } from "../lib/content";
import { withBase } from "../lib/urls";
import lightThread from "../../public/images/loose-ends-light.png";
import darkThread from "../../public/images/loose-ends-dark.png";

// Reuse the original thread's alpha for the matching dark recolor.
const threadMask = await getImage({ src: lightThread, width: 1440, format: "webp", quality: 85 });

const articles = (await getCollection("articles"))
  .filter((article) => article.data.pubDate.valueOf() <= Date.now())
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestArticle = articles[0];
const projects = (await getCollection("projects"))
  .filter((project) => project.data.status === "public")
  .sort((a, b) => a.data.order - b.data.order);
const experiment = projects.find((project) => project.data.featured) ?? projects[0];
const featuredSummary = latestArticle && getEntrySlug(latestArticle) === "a-bridge-is-the-wrong-job-description"
  ? "A working theory about how the TPM role may change as AI reduces some of the usual handoffs."
  : latestArticle?.data.description;
const formatDate = (date: Date) => new Intl.DateTimeFormat("en-GB", {
  day: "2-digit", month: "short", year: "numeric", timeZone: "Asia/Jakarta"
}).format(date);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Hilmi Muktitama",
  jobTitle: "Senior Technical Program Manager",
  url: new URL(import.meta.env.BASE_URL, Astro.site ?? "https://hilmimuktitama.github.io").toString(),
  sameAs: ["https://github.com/hilmimuktitama", "https://www.linkedin.com/in/hilmimuktitama"]
};
---

<BaseLayout structuredData={structuredData}>
  <div class="home-page">
    <section class="home-hero" aria-labelledby="hero-title">
      <div class="home-hero-copy">
        <h1 id="hero-title"><span>A few things</span><span>I’m figuring out.</span></h1>
        <p>Software work, AI tools, and the parts<br class="desktop-break" /> that still need a person.</p>
      </div>
      <div class="home-thread" aria-hidden="true">
        <Image class="thread-light" src={lightThread} alt="" widths={[640, 1024, 1440, 1870]} sizes="(max-width: 600px) 100vw, (max-width: 1600px) 94vw, 1504px" format="webp" quality={85} loading="eager" fetchpriority="high" />
        <Image class="thread-dark" style={{ maskImage: `url("${threadMask.src}")` }} src={darkThread} alt="" widths={[640, 1024, 1440, 1870]} sizes="(max-width: 600px) 100vw, (max-width: 1600px) 94vw, 1504px" format="webp" quality={85} loading="eager" />
      </div>
      <p class="home-caption">Some things take a<br /> little untangling.</p>
    </section>

    <div class="home-notes">
      <section class="home-recent" id="articles" aria-labelledby="recent-title">
        <header class="home-note-meta">
          <h2 class="eyebrow" id="recent-title">A recent note</h2>
          {latestArticle && <time datetime={latestArticle.data.pubDate.toISOString()}>{formatDate(latestArticle.data.pubDate)}</time>}
        </header>
        {latestArticle ? (
          <article>
            <h3><a href={withBase(`/articles/${getEntrySlug(latestArticle)}/`)}>{latestArticle.data.title}</a></h3>
            <p>{featuredSummary}</p>
            <a class="text-link" href={withBase(`/articles/${getEntrySlug(latestArticle)}/`)}>Read the essay</a>
          </article>
        ) : <p>Writing will appear here once there is something useful to share.</p>}
      </section>
      {experiment && (
        <section class="home-workbench" id="experiments" aria-labelledby="workbench-title">
          <h2 class="eyebrow" id="workbench-title">On the workbench</h2>
          <article>
            <h3><a href={withBase(`/work/${getEntrySlug(experiment)}/`)}>{experiment.data.title}</a></h3>
            <p>{experiment.data.description}</p>
            <a class="text-link" href={withBase(`/work/${getEntrySlug(experiment)}/`)}>Explore the experiment</a>
          </article>
        </section>
      )}
    </div>
    <p class="home-all-writing"><a class="text-link" href={withBase("/articles/")}>All writing</a></p>

    <section class="home-background" id="principles" aria-labelledby="background-title">
      <h2 id="background-title">A little context.</h2>
      <div>
        <p>I’m a Senior TPM at Mekari. I started in QA, moved into product, and now help teams plan and deliver platform and automation work.</p>
        <p>I try to separate facts from assumptions, make decisions easy to check, and follow through on the small things that decide how the work goes.</p>
        <a class="text-link" href={withBase("/resume/")}>View full resume <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
      </div>
    </section>
  </div>
</BaseLayout>
