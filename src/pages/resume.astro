---
import BaseLayout from "../layouts/BaseLayout.astro";
import { GITHUB_URL, LINKEDIN_URL } from "../lib/urls";
import { CONTACT_EMAIL, getResumeEntries, groupExperienceByOrganization } from "../lib/resume";

const entries = await getResumeEntries();
const experience = entries.filter((entry) => entry.data.section === "experience");
const experienceGroups = groupExperienceByOrganization(experience);
const skills = entries.filter((entry) => entry.data.section === "skill");
const education = entries.filter((entry) => entry.data.section === "education");
const certifications = entries.filter((entry) => entry.data.section === "certification");
---

<BaseLayout
  title="Resume"
  description="Resume for Hilmi Muktitama, a technical program manager with a background in QA, product management, and software delivery."
  structuredData={{
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Hilmi Muktitama",
    jobTitle: "Senior Technical Program Manager",
    url: new URL(Astro.url.pathname, Astro.site ?? "https://hilmimuktitama.github.io").toString(),
    sameAs: [LINKEDIN_URL, GITHUB_URL]
  }}
>
  <article class="resume-page" aria-labelledby="resume-title">
    <header class="resume-hero resume-intro">
      <div class="section-aside">
        <p class="eyebrow">Resume</p>
      </div>
      <div class="resume-hero-body">
        <h1 id="resume-title">Hilmi Muktitama</h1>
        <p class="role-title">Senior Technical Program Manager</p>
        <p class="lede">
          I work across program, product, and technical delivery, helping teams plan and ship complex platform and automation work.
        </p>
        <div class="resume-actions" aria-label="Resume actions">
          <a class="resume-action resume-action-primary" href={`mailto:${CONTACT_EMAIL}`}>Contact me <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
          <a class="external-link" href={LINKEDIN_URL} target="_blank" rel="noreferrer">View on LinkedIn <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
          <a class="external-link" href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
        </div>
      </div>
    </header>

    <section class="resume-section resume-experience" aria-labelledby="experience-title">
      <header class="resume-section-heading">
        <p class="eyebrow">Experience</p>
        <h2 id="experience-title">Work history</h2>
      </header>
      <div class="resume-timeline">
        {experienceGroups.map((group) => (
          <section class="resume-employer" aria-labelledby={`employer-${group.organization.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}>
            <header class="resume-employer-heading">
              <p class="eyebrow">Employer</p>
              <h3 id={`employer-${group.organization.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}>{group.organization}</h3>
            </header>
            <div class="resume-employer-roles">
              {group.roles.map((entry) => (
                <article class="resume-role resume-experience-entry">
                  <div class="resume-role-meta">
                    <p><span class="sr-only">Period: </span>{entry.data.period}</p>
                    {entry.data.location && <p>{entry.data.location}</p>}
                  </div>
                  <div>
                    <h4>{entry.data.title}</h4>
                    <p>{entry.data.summary}</p>
                    {entry.data.items.length > 0 && (
                      <ul class="resume-bullets">
                        {entry.data.items.map((item) => <li>{item}</li>)}
                      </ul>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="resume-section resume-credentials" aria-labelledby="credentials-title">
      <header class="resume-section-heading">
        <p class="eyebrow">Background</p>
        <h2 id="credentials-title">Skills, education, and certifications</h2>
      </header>
      <div class="resume-credential-groups">
        <section class="resume-credential-group resume-skill-block" aria-labelledby="skills-title">
          <h3 id="skills-title">Areas I work in</h3>
          {skills.map((entry) => (
            <div>
              <p>{entry.data.summary}</p>
              <div class="tag-row">
                {entry.data.items.map((item) => <span class="tag">{item}</span>)}
              </div>
            </div>
          ))}
        </section>

        <section class="resume-credential-group" aria-labelledby="education-title">
          <h3 id="education-title">Education</h3>
          {education.map((entry) => (
            <div class="credential-item">
              <p class="credential-title">{entry.data.title}</p>
              {entry.data.organization && <p>{entry.data.organization}</p>}
              {entry.data.period && <p class="meta">{entry.data.period}</p>}
              <p>{entry.data.summary}</p>
              {entry.data.items.length > 0 && (
                <ul class="credential-list">
                  {entry.data.items.map((item) => <li>{item}</li>)}
                </ul>
              )}
            </div>
          ))}
        </section>

        <section class="resume-credential-group" aria-labelledby="certifications-title">
          <h3 id="certifications-title">Certifications</h3>
          {certifications.map((entry) => (
            <div class="credential-item">
              {entry.data.summary && <p>{entry.data.summary}</p>}
              {entry.data.items.length > 0 && (
                <ul class="credential-list">
                  {entry.data.items.map((item) => <li>{item}</li>)}
                </ul>
              )}
            </div>
          ))}
        </section>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .resume-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 1.25rem;
    margin-top: 1.75rem;
  }

  .resume-action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .resume-action-primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }

  .resume-action-primary:hover {
    color: var(--bg);
  }

  .resume-actions .external-link {
    text-decoration: underline;
  }

  .resume-employer + .resume-employer {
    margin-top: 3.25rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--rule);
  }

  .resume-employer-heading h3 {
    margin-top: 0.6rem;
    font-size: 1.25rem;
  }

  .resume-employer-roles {
    margin-top: 1.5rem;
  }

  .resume-employer-roles .resume-role {
    padding-bottom: 2.5rem;
  }

  .resume-employer-roles .resume-role + .resume-role {
    padding-top: 2rem;
  }

  .resume-role h4 {
    font-size: 1.55rem;
    line-height: 1.2;
  }

  .resume-employer-roles .resume-role:first-child h4 {
    color: var(--accent);
  }

  @media (max-width: 600px) {
    .resume-actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.75rem;
    }

    .resume-employer + .resume-employer {
      margin-top: 2.5rem;
      padding-top: 2rem;
    }
  }

  @media print {
    .resume-actions,
    .resume-employer-heading .eyebrow {
      display: none;
    }

    .resume-employer + .resume-employer {
      margin-top: 1.5rem;
      padding-top: 1rem;
    }
  }
</style>
