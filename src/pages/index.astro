---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TangledMotion from "../components/TangledMotion.astro";
import LineStudy from "../components/LineStudy.astro";
import { getEntrySlug } from "../lib/content";
import { GITHUB_URL, LINKEDIN_URL, withBase } from "../lib/urls";
import "../styles/editorial-layout.css";
import "../styles/tangled-world.css";
const articles = (await getCollection("articles"))
  .filter((article) => article.data.pubDate.valueOf() <= Date.now())
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const notes = articles.slice(1, 4);
const projects = (await getCollection("projects"))
  .filter((project) => project.data.status === "public")
  .sort((a, b) => a.data.order - b.data.order);
const lead = articles[0] ? {
  title: articles[0].data.title, description: articles[0].data.description,
  href: withBase(`/articles/${getEntrySlug(articles[0])}/`),
  kind: "Writing", date: articles[0].data.pubDate
} : projects[0] ? {
  title: projects[0].data.title, description: projects[0].data.description,
  href: withBase(`/work/${getEntrySlug(projects[0])}/`),
  kind: "Experiment", date: projects[0].data.updatedDate
} : null;
const formatDate = (date: Date) => new Intl.DateTimeFormat("en-GB", {
  day: "2-digit", month: "short", year: "numeric", timeZone: "Asia/Jakarta"
}).format(date);
const structuredData = {
  "@context": "https://schema.org", "@type": "Person", name: "Hilmi Muktitama",
  url: new URL(import.meta.env.BASE_URL, Astro.site ?? "https://hilmimuktitama.github.io").toString(),
  sameAs: [GITHUB_URL, LINKEDIN_URL]
};
---
<BaseLayout immersive showContactFooter={false} structuredData={structuredData}>
  <noscript><style>.world-motion{display:none!important}</style></noscript>
  <div class="editorial-home" data-dzn-page="home">
    <section class="editorial-hero" id="top" data-dzn-region="intro" aria-labelledby="hero-title">
      <p class="editorial-eyebrow hero-eyebrow">{lead && <><span>{lead.kind}</span>{lead.date && <><span aria-hidden="true">/</span><time datetime={lead.date.toISOString()}>{formatDate(lead.date)}</time></>}</>}</p>
      <h1 id="hero-title" data-dzn-part="title">{lead ? <a href={lead.href}>{lead.title}</a> : "Hilmi Muktitama"}</h1>
      <div class="hero-support" data-dzn-part="body">
        {lead && <><p>{lead.description}</p><a class="editorial-link" href={lead.href}>{lead.kind === "Writing" ? "Read the note" : "Explore the experiment"} <span aria-hidden="true">↗</span></a></>}
      </div>
      <div class="hero-line-study"><LineStudy variant="hero" /></div>
    </section>
    {notes.length > 0 && <section class="editorial-writing" id="articles" data-dzn-region="writing" aria-labelledby="writing-title" tabindex="-1">
      <header class="editorial-section-heading" data-editorial-reveal>
        <h2 id="writing-title" data-dzn-part="title"><span class="section-mark" aria-hidden="true"></span>Writing</h2>
        <a class="editorial-link" href={withBase("/articles/")}>All writing <span aria-hidden="true">↗</span></a>
      </header>
      <div class="editorial-notes" data-dzn-part="body">
        {notes.map((article, index) => <article class:list={["editorial-note", { "is-lead": index === 0 }]} data-editorial-reveal>
          <div class="editorial-note-meta"><span>{String(index + 1).padStart(2, "0")}</span><time datetime={article.data.pubDate.toISOString()}>{formatDate(article.data.pubDate)}</time></div>
          <div class="editorial-note-copy">
            <h3 class="view-transition-title" style={`--title-view-transition-name: article-title-${getEntrySlug(article)}`}><a href={withBase(`/articles/${getEntrySlug(article)}/`)}>{article.data.title}</a></h3>
            <p>{article.data.description}</p>
          </div>
          <a class="editorial-note-arrow" href={withBase(`/articles/${getEntrySlug(article)}/`)} aria-label={`Read ${article.data.title}`}><span aria-hidden="true">↗</span></a>
        </article>)}
      </div>
    </section>}
    {projects.length > 0 && <section class="editorial-experiments" id="experiments" data-dzn-region="experiments" aria-labelledby="experiments-title" tabindex="-1">
      <header class="editorial-section-heading" data-editorial-reveal>
        <h2 id="experiments-title" data-dzn-part="title"><span class="section-mark" aria-hidden="true"></span>Experiments</h2>
        <a class="editorial-link" href={withBase("/work/")}>All experiments <span aria-hidden="true">↗</span></a>
      </header>
      <div class="experiment-line-study"><LineStudy variant="section" /></div>
      <div class="editorial-projects" data-dzn-part="body">
        {projects.map((project, index) => <article class="editorial-project" data-editorial-reveal>
          <p class="editorial-project-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</p>
          <h3 class="view-transition-title" style={`--title-view-transition-name: experiment-title-${getEntrySlug(project)}`}><a href={withBase(`/work/${getEntrySlug(project)}/`)}>{project.data.title}</a></h3>
          <p class="editorial-project-description">{project.data.description}</p>
          <a class="editorial-project-arrow" href={withBase(`/work/${getEntrySlug(project)}/`)} aria-label={`Explore ${project.data.title}`}><span aria-hidden="true">↗</span></a>
        </article>)}
      </div>
    </section>}
    <footer class="editorial-contact" id="say-hello" data-dzn-region="contact" tabindex="-1">
      <div class="editorial-colophon" data-dzn-part="body">
        <span>Hilmi Muktitama</span>
        <nav aria-label="Footer navigation">
          <a href="mailto:hilmimukti@gmail.com">Email <span aria-hidden="true">↗</span></a>
          <a href={LINKEDIN_URL} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
          <a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          <a href="#top">Back to top <span aria-hidden="true">↑</span></a>
        </nav>
      </div>
    </footer>
  </div>
  <TangledMotion />
</BaseLayout>
