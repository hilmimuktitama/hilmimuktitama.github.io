---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEntrySlug } from "../../lib/content";
import { withBase } from "../../lib/urls";

const now = Date.now();

const articles = (await getCollection("articles"))
  .filter((article) => article.data.pubDate.valueOf() <= now)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (date: Date) =>
  date.toLocaleDateString("en", {
    day: "2-digit",
    month: "short",
    year: "numeric",
    timeZone: "Asia/Jakarta"
  });
---

<BaseLayout title="Writing" description="Notes on delivery work, planning, and program execution by Hilmi Muktitama.">
  <section class="section page-intro" aria-labelledby="articles-title">
    <div class="section-aside">
      <p class="eyebrow">Field notes</p>
      <p class="section-number" aria-hidden="true">03</p>
    </div>
    <div class="page-intro-main">
      <div class="page-intro-body">
        <h1 id="articles-title">Writing on software work, AI, and execution.</h1>
        <p class="lede">Personal notes on building with AI, technical work, and the operating habits behind software delivery.</p>
        <p class="page-note">Some are working theories. Some are lessons I only understood after the work got uncomfortable.</p>
      </div>
      <div class="article-index-list">
        {articles.map((article) => (
          <article class="article-index-item">
            <p class="item-meta">{formatDate(article.data.pubDate)}</p>
            <div>
              <h2><a href={withBase(`/articles/${getEntrySlug(article)}/`)}>{article.data.title}</a></h2>
              <p>{article.data.description}</p>
              <div class="tag-row">
                {article.data.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
            <a class="row-action" href={withBase(`/articles/${getEntrySlug(article)}/`)} aria-label={`Read ${article.data.title}`}>Read <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
