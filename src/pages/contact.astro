---
import BaseLayout from "../layouts/BaseLayout.astro";
import { GITHUB_URL, LINKEDIN_URL } from "../lib/urls";
import { CONTACT_EMAIL } from "../lib/resume";
---

<BaseLayout
  title="Contact"
  description="Get in touch with Hilmi Muktitama about technical program work, product delivery, or software projects."
  showContactFooter={false}
>
  <section class="section contact-page" aria-labelledby="contact-title">
    <div class="section-aside">
      <p class="eyebrow">Contact</p>
    </div>
    <div class="contact-body">
      <header class="contact-header">
        <p class="eyebrow">Hilmi Muktitama <span class="eyebrow-divider">/</span> Jakarta, Indonesia</p>
        <h1 id="contact-title">Get in touch.</h1>
        <p class="lede">Contact me about technical program roles, product delivery, or software projects.</p>
      </header>
      <address class="contact-letter contact-primary">
        <p class="eyebrow">Best way to reach me</p>
        <div class="contact-email-row">
          <a class="contact-email" href={`mailto:${CONTACT_EMAIL}`}><span data-contact-email>{CONTACT_EMAIL}</span> <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
          <button class="copy-email" type="button" data-copy-email={CONTACT_EMAIL}>
            <span class="copy-email-content">
              <i class="ph ph-copy" data-copy-icon aria-hidden="true"></i>
              <span data-copy-label>Copy email</span>
            </span>
          </button>
        </div>
        <p class="copy-status" data-copy-status role="status" aria-live="polite"></p>
        <p class="contact-note">A short note about the problem, the team, or the role is a good place to start.</p>
      </address>
      <nav class="contact-elsewhere contact-secondary" aria-label="Other ways to connect">
        <p class="eyebrow">Elsewhere</p>
        <a class="external-link" href={LINKEDIN_URL} target="_blank" rel="noreferrer">LinkedIn <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
        <a class="external-link" href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  .copy-email {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-inline-size: 8rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    white-space: nowrap;
  }

  .copy-email-content {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .copy-email[data-copy-state="success"] {
    border-color: var(--accent);
    background: var(--bg-soft);
    color: var(--accent);
  }

  .copy-email[data-copy-motion="pointer"] .copy-email-content {
    transition: opacity 140ms ease, transform 140ms ease;
  }

  .copy-email[data-copy-motion="pointer"][data-copy-feedback="from"] .copy-email-content {
    opacity: 0.82;
    transform: translateY(2px);
  }

  .copy-email[data-copy-motion="pointer"][data-copy-feedback="settled"] .copy-email-content {
    opacity: 1;
    transform: translateY(0);
  }

  .copy-email:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .copy-status {
    min-height: 1.35em;
    margin-top: 0.3rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 600px) {
    .contact-email-row {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .copy-email[data-copy-motion="pointer"] .copy-email-content {
      transition: none;
    }
  }
</style>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-email]");
  const copyStatus = document.querySelector<HTMLElement>("[data-copy-status]");
  const copyIcon = copyButton?.querySelector<HTMLElement>("[data-copy-icon]");
  const copyLabel = copyButton?.querySelector<HTMLElement>("[data-copy-label]");
  const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
  let resetTimer: number | undefined;
  let feedbackTimer: number | undefined;
  let feedbackFrame: number | undefined;

  const cancelVisualTimers = () => {
    if (resetTimer !== undefined) window.clearTimeout(resetTimer);
    if (feedbackTimer !== undefined) window.clearTimeout(feedbackTimer);
    if (feedbackFrame !== undefined) window.cancelAnimationFrame(feedbackFrame);
    resetTimer = undefined;
    feedbackTimer = undefined;
    feedbackFrame = undefined;
  };

  const resetCopyVisual = () => {
    cancelVisualTimers();
    copyButton?.removeAttribute("data-copy-state");
    copyButton?.removeAttribute("data-copy-motion");
    copyButton?.removeAttribute("data-copy-feedback");
    if (copyIcon) copyIcon.className = "ph ph-copy";
    if (copyLabel) copyLabel.textContent = "Copy email";
  };

  const showCopiedVisual = (pointerActivated: boolean) => {
    copyButton?.setAttribute("data-copy-state", "success");
    if (copyIcon) copyIcon.className = "ph ph-check";
    if (copyLabel) copyLabel.textContent = "Copied";

    if (!pointerActivated || motionPreference.matches || !copyButton) return;

    copyButton.setAttribute("data-copy-motion", "pointer");
    copyButton.setAttribute("data-copy-feedback", "from");
    feedbackFrame = window.requestAnimationFrame(() => {
      feedbackFrame = window.requestAnimationFrame(() => {
        copyButton.setAttribute("data-copy-feedback", "settled");
        feedbackFrame = undefined;

        feedbackTimer = window.setTimeout(() => {
          copyButton.removeAttribute("data-copy-motion");
          copyButton.removeAttribute("data-copy-feedback");
          feedbackTimer = undefined;
        }, 160);
      });
    });
  };

  const selectEmailForManualCopy = () => {
    const emailLink = document.querySelector<HTMLElement>("[data-contact-email]");
    const selection = window.getSelection();
    if (!emailLink || !selection) return false;

    const range = document.createRange();
    range.selectNodeContents(emailLink);
    selection.removeAllRanges();
    selection.addRange(range);
    return true;
  };

  copyButton?.addEventListener("click", async (event) => {
    const email = copyButton.dataset.copyEmail;
    if (!email || !copyStatus) return;

    resetCopyVisual();
    copyButton.disabled = true;
    let copied = false;
    let manuallySelected = false;
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(email);
        copied = true;
      } else {
        manuallySelected = selectEmailForManualCopy();
      }
    } catch {
      manuallySelected = selectEmailForManualCopy();
    } finally {
      copyButton.disabled = false;
    }

    copyStatus.textContent = copied
      ? "Email copied to clipboard."
      : manuallySelected
        ? "Email selected. Press Command+C or Ctrl+C to copy it."
        : "Copy was unavailable. You can select the email address manually.";

    if (copied) {
      showCopiedVisual(event.detail > 0);
      resetTimer = window.setTimeout(() => {
        resetCopyVisual();
      }, 2000);
    }
  });

  motionPreference.addEventListener("change", resetCopyVisual);
</script>
