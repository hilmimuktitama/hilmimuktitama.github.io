---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { GITHUB_URL, LINKEDIN_URL } from "../lib/urls";

const entries = (await getCollection("resume")).sort((a, b) => a.data.order - b.data.order);
const experience = entries.filter((entry) => entry.data.section === "experience");
const skills = entries.filter((entry) => entry.data.section === "skill");
const education = entries.filter((entry) => entry.data.section === "education");
const certifications = entries.filter((entry) => entry.data.section === "certification");
---

<BaseLayout
  title="Resume"
  description="Resume for Hilmi Muktitama, a Senior Technical Program Manager at Mekari with a background in QA, product management, and software delivery."
  structuredData={{
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Hilmi Muktitama",
    jobTitle: "Senior Technical Program Manager",
    url: new URL(Astro.url.pathname, Astro.site ?? "https://hilmimuktitama.github.io").toString(),
    sameAs: [LINKEDIN_URL, GITHUB_URL],
    worksFor: { "@type": "Organization", name: "Mekari" }
  }}
>
  <article class="resume-page" aria-labelledby="resume-title">
    <header class="resume-hero resume-intro">
      <div class="section-aside">
        <p class="eyebrow">Resume</p>
      </div>
      <div class="resume-hero-body">
        <h1 id="resume-title">Hilmi Muktitama</h1>
        <p class="role-title">Senior Technical Program Manager</p>
        <p class="lede">
          I’m a Senior TPM at Mekari. I started in QA, moved into product, and now help teams plan and deliver platform and automation work.
        </p>
        <div class="resume-contact" aria-label="Public resume contact links">
          <a class="external-link" href={LINKEDIN_URL} target="_blank" rel="noreferrer">LinkedIn</a>
          <a class="external-link" href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
        </div>
      </div>
    </header>

    <section class="resume-section resume-experience" aria-labelledby="experience-title">
      <header class="resume-section-heading">
        <p class="eyebrow">Experience</p>
        <h2 id="experience-title">Work history</h2>
      </header>
      <div class="resume-timeline">
        {experience.map((entry) => (
          <article class="resume-role resume-experience-entry">
            <div class="resume-role-meta">
              <p><span class="sr-only">Period: </span>{entry.data.period}</p>
              {entry.data.location && <p>{entry.data.location}</p>}
            </div>
            <div>
              <h3>{entry.data.title}</h3>
              {entry.data.organization && <p class="resume-org">{entry.data.organization}</p>}
              <p>{entry.data.summary}</p>
              {entry.data.items.length > 0 && (
                <ul class="resume-bullets">
                  {entry.data.items.map((item) => <li>{item}</li>)}
                </ul>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="resume-section resume-credentials" aria-labelledby="credentials-title">
      <header class="resume-section-heading">
        <p class="eyebrow">Background</p>
        <h2 id="credentials-title">Skills, education, and certifications</h2>
      </header>
      <div class="resume-credential-groups">
        <section class="resume-credential-group resume-skill-block" aria-labelledby="skills-title">
          <h3 id="skills-title">Areas I work in</h3>
          {skills.map((entry) => (
            <div>
              <p>{entry.data.summary}</p>
              <div class="tag-row">
                {entry.data.items.map((item) => <span class="tag">{item}</span>)}
              </div>
            </div>
          ))}
        </section>

        <section class="resume-credential-group" aria-labelledby="education-title">
          <h3 id="education-title">Education</h3>
          {education.map((entry) => (
            <div class="credential-item">
              <p class="credential-title">{entry.data.title}</p>
              {entry.data.organization && <p>{entry.data.organization}</p>}
              {entry.data.period && <p class="meta">{entry.data.period}</p>}
              <p>{entry.data.summary}</p>
              {entry.data.items.length > 0 && (
                <ul class="credential-list">
                  {entry.data.items.map((item) => <li>{item}</li>)}
                </ul>
              )}
            </div>
          ))}
        </section>

        <section class="resume-credential-group" aria-labelledby="certifications-title">
          <h3 id="certifications-title">Certifications</h3>
          {certifications.map((entry) => (
            <div class="credential-item">
              <p class="credential-title">{entry.data.title}</p>
              {entry.data.summary && <p>{entry.data.summary}</p>}
              {entry.data.items.length > 0 && (
                <ul class="credential-list">
                  {entry.data.items.map((item) => <li>{item}</li>)}
                </ul>
              )}
            </div>
          ))}
        </section>
      </div>
    </section>
  </article>
</BaseLayout>
