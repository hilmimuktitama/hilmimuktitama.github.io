---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEntrySlug } from "../../lib/content";
import { withBase } from "../../lib/urls";

export async function getStaticPaths() {
  const now = Date.now();
  const articles = (await getCollection("articles")).filter(
    (article) => article.data.pubDate.valueOf() <= now
  );
  return articles.map((article) => ({
    params: { slug: getEntrySlug(article) },
    props: { article }
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const publishedArticles = (await getCollection("articles"))
  .filter((entry) => entry.data.pubDate.valueOf() <= Date.now())
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const currentIndex = publishedArticles.findIndex((entry) => getEntrySlug(entry) === getEntrySlug(article));
const nextArticle = publishedArticles[currentIndex + 1] ?? publishedArticles[0];
const formattedDate = article.data.pubDate.toLocaleDateString("en", {
  day: "2-digit",
  month: "short",
  year: "numeric",
  timeZone: "Asia/Jakarta"
});
---

<BaseLayout title={article.data.title} description={article.data.description}>
  <article class="reading-page article-detail-page">
    <header class="reading-header">
      <div class="reading-header-top">
        <a class="back-link" href={withBase("/articles/")}>← All writing</a>
        <span class="section-number" aria-hidden="true">✳</span>
      </div>
      <p class="eyebrow">Field note <span class="eyebrow-divider">/</span> {formattedDate}</p>
      <h1>{article.data.title}</h1>
      <p class="lede">{article.data.description}</p>
      {article.data.tags.length > 0 && (
        <div class="tag-row" aria-label="Article tags">
          {article.data.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>
    <div class="reading-layout">
      <aside class="reading-aside">
        <p class="eyebrow">A note from the notebook</p>
        <p>Read slowly. The useful part is usually one paragraph past the summary.</p>
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>
    <footer class="article-next">
      <p class="eyebrow">Continue reading</p>
      <a href={withBase(`/articles/${getEntrySlug(nextArticle)}/`)}>
        <span>{nextArticle.data.title}</span>
        <span aria-hidden="true">↗</span>
      </a>
      <a class="all-writing" href={withBase("/articles/")}>View all writing</a>
    </footer>
  </article>
</BaseLayout>
