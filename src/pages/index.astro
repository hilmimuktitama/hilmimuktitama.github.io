---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntrySlug } from "../lib/content";
import { withBase } from "../lib/urls";

const projects = (await getCollection("projects"))
  .filter((project) => project.data.status === "public")
  .sort((a, b) => a.data.order - b.data.order);
const visibleProjects = projects.slice(0, 3);

const now = Date.now();

const articles = (await getCollection("articles"))
  .filter((article) => article.data.pubDate.valueOf() <= now)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const formatDate = (date?: Date) =>
  date?.toLocaleDateString("en", { month: "short", year: "numeric", timeZone: "Asia/Jakarta" }) ??
  "Ready for update";
---

<BaseLayout>
  <section class="section home-intro" aria-labelledby="hero-title">
    <div class="section-aside">
      <p class="eyebrow">Portfolio / 2026</p>
      <p class="section-number" aria-hidden="true">00</p>
    </div>
    <div class="home-intro-body">
      <p class="eyebrow">Hilmi Muktitama <span class="eyebrow-divider">/</span> Senior Technical Program Manager</p>
      <h1 id="hero-title">Making complex software work easier to trust.</h1>
      <div class="home-intro-detail">
        <p class="lede">
          I work across product, engineering, and QA to turn platform and automation programs into source-backed plans, clear decisions, and release-ready work.
        </p>
        <div class="home-intro-actions" aria-label="Primary profile links">
          <a class="button-link primary" href={withBase("/work/")}>Read the work <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={withBase("/resume/")}>View resume <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="home-proof-strip" aria-label="Experience highlights">
        <div><strong>5+ years</strong><span>program, product, and QA</span></div>
        <div><strong>Senior TPM</strong><span>B2B SaaS delivery at Mekari</span></div>
        <div><strong>20+ clients</strong><span>supported through API integration</span></div>
      </div>
    </div>
  </section>

  <section class="section home-practice" aria-labelledby="practice-title">
    <div class="section-aside">
      <p class="eyebrow">The practice</p>
      <p class="section-number" aria-hidden="true">01</p>
    </div>
    <div>
      <div class="section-heading compact">
        <h2 id="practice-title">The work between a question and a release.</h2>
        <p>I like the part where the information is incomplete, the teams are moving, and someone has to make the next decision easier.</p>
      </div>
      <div class="practice-list">
        <article>
          <span class="practice-index">01</span>
          <h3>Find the signal</h3>
          <p>Separate facts, assumptions, blockers, owners, and open questions before the status story hardens.</p>
        </article>
        <article>
          <span class="practice-index">02</span>
          <h3>Make it reviewable</h3>
          <p>Turn scattered inputs into plans, evidence packs, timelines, and decisions that another person can inspect.</p>
        </article>
        <article>
          <span class="practice-index">03</span>
          <h3>Keep it moving</h3>
          <p>Coordinate the dependencies, release gates, and follow-through that help a good plan survive contact with delivery.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section home-work" id="case-studies" aria-labelledby="case-studies-title">
    <div class="section-aside">
      <p class="eyebrow">Selected work</p>
      <p class="section-number" aria-hidden="true">02</p>
    </div>
    <div>
      <div class="section-heading compact">
        <h2 id="case-studies-title">Systems that make delivery evidence visible.</h2>
        <p>Public projects showing how I turn ambiguous inputs into reviewable execution artifacts.</p>
      </div>
      <div class="editorial-work-list">
        {visibleProjects.map((project, index) => (
          <a class={`editorial-work-item ${index === 0 ? "is-featured" : ""}`} href={withBase(`/work/${getEntrySlug(project)}/`)}>
            <span class="item-index">0{index + 1}</span>
            <div class="editorial-work-copy">
              <div class="item-meta"><span>{index === 0 ? "Featured case study" : "Case study"}</span><span>{formatDate(project.data.updatedDate)}</span></div>
              <h3>{project.data.title}</h3>
              <p>{project.data.description}</p>
              <div class="tag-row">
                {project.data.tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
            <span class="item-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      <p class="inline-action"><a href={withBase("/work/")}>View all work <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="section home-writing" id="articles" aria-labelledby="articles-title">
    <div class="section-aside">
      <p class="eyebrow">Writing</p>
      <p class="section-number" aria-hidden="true">03</p>
    </div>
    <div>
      <div class="section-heading compact">
        <h2 id="articles-title">Notes from inside software delivery.</h2>
        <p>Practical writing on AI tooling, technical judgment, and the habits behind reliable execution.</p>
      </div>
      {articles.length > 0 ? (
        <div class="editorial-article-list">
          {articles.map((article, index) => (
            <a class={`editorial-article-item ${index === 0 ? "is-featured" : ""}`} href={withBase(`/articles/${getEntrySlug(article)}/`)}>
              <span class="item-index">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <p class="meta">{formatDate(article.data.pubDate)}</p>
                <h3>{article.data.title}</h3>
                <p>{article.data.description}</p>
              </div>
              <span class="item-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
        <p class="inline-action"><a href={withBase("/articles/")}>Read all writing <span aria-hidden="true">→</span></a></p>
      ) : (
        <p class="empty-note">Writing will appear here once there is something useful to share.</p>
      )}
    </div>
  </section>

  <section class="section home-resume" id="resume" aria-labelledby="resume-title">
    <div class="section-aside">
      <p class="eyebrow">A short history</p>
      <p class="section-number" aria-hidden="true">04</p>
    </div>
    <div>
      <div class="section-heading compact">
        <h2 id="resume-title">A path from testing systems to leading them.</h2>
        <p>QA engineering built the technical instinct. Product management added customer and platform ownership. TPM work brought both into cross-squad execution.</p>
      </div>
      <div class="career-path" aria-label="Career progression">
        <div><span>2019</span><strong>Quality Assurance</strong></div>
        <div><span>2020</span><strong>Product Management</strong></div>
        <div><span>2022—now</span><strong>Technical Program Management</strong></div>
      </div>
      <p class="inline-action"><a href={withBase("/resume/")}>View full resume <span aria-hidden="true">→</span></a></p>
    </div>
  </section>
</BaseLayout>
