---
import { getCollection } from 'astro:content';
import { getEntrySlug } from '../lib/content';
import { withBase, GITHUB_URL, LINKEDIN_URL } from '../lib/urls';
import GroundStage from '../components/ground/GroundStage.astro';
import GroundArrow from '../components/ground/GroundArrow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
const articles=(await getCollection('articles')).filter(a=>a.data.pubDate.valueOf()<=Date.now()).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const projects=(await getCollection('projects')).filter(p=>p.data.status==='public').sort((a,b)=>a.data.order-b.data.order);
const date=(d:Date)=>new Intl.DateTimeFormat('en-GB',{day:'2-digit',month:'short',year:'numeric',timeZone:'Asia/Jakarta'}).format(d);
const AI_TOPIC_TAGS=['ai','building','tools','agents'];
const TEAMS_TOPIC_TAGS=['tpm','product','judgment','prioritization','documentation'];
const hasTopicTag=(tags:string[],topics:string[])=>tags.some(tag=>topics.includes(tag.toLowerCase()));
const noteLabel=(count:number)=>`${count} ${count===1?'note':'notes'}`;

const structuredData = {
  '@context': 'https://schema.org', '@type': 'Person', name: 'Hilmi Muktitama',
  url: new URL(import.meta.env.BASE_URL, Astro.site ?? 'https://hilmimuktitama.github.io').toString(),
  sameAs: [GITHUB_URL, LINKEDIN_URL]
};
---
<BaseLayout immersive structuredData={structuredData} description="Writing, experiments, and notes on technology and work by Hilmi Muktitama.">

<section class="ground-hero" aria-labelledby="ground-title" data-ground-hero>
<div class="hero-topline"><span class="micro">Based in Indonesia</span></div>
<h1 id="ground-title"><span class="headline-line"><span class="title-mask"><span data-title-reveal>Good work</span></span></span> <span class="headline-line second"><span class="title-mask title-serif"><em data-title-reveal>happens</em></span> <span class="title-mask title-final"><span data-title-reveal>between.</span></span></span></h1>
<div class="hero-lower"><div class="hero-intro"><p>I'm Hilmi. I work across engineering teams, write to understand, and build small things to find out.</p><a class="round-link" href="#writing"><span class="round-arrow"><GroundArrow direction="down"/></span><span>Read my writing</span></a></div><div class="sculpture-wrap"><GroundStage/></div></div>
</section>
<div class="word-ribbon" aria-hidden="true"></div>
<section class="ground-writing" id="writing" aria-labelledby="writing-title">
<header class="chapter-heading"><div><h2 id="writing-title"><em>Writing</em></h2><p>Notes on technology, work, and what I'm learning.</p></div></header>
<div class="writing-toolbar" data-writing-filters hidden><div role="group" aria-label="Filter writing"><button type="button" data-filter="all" aria-pressed="true">Everything</button><button type="button" data-filter="ai" aria-pressed="false">AI & building</button><button type="button" data-filter="teams" aria-pressed="false">People & programs</button></div><p data-writing-count role="status" aria-live="polite">{noteLabel(articles.length)}</p></div>
<div class="notebook-grid">{articles.map((article,i)=><article class:list={['notebook-card',{'notebook-lead':i===0}]} data-note data-topic={[hasTopicTag(article.data.tags,AI_TOPIC_TAGS)?'ai':'',hasTopicTag(article.data.tags,TEAMS_TOPIC_TAGS)?'teams':''].filter(Boolean).join(' ')}>
<div class="note-meta"><time datetime={article.data.pubDate.toISOString()}>{date(article.data.pubDate)}</time><span>{article.data.tags[0]??'Notes'}</span></div>
{i===0&&<div class="note-art" aria-hidden="true"><span class="note-art-arch"></span><span class="note-art-circle"></span><span class="note-art-block"></span></div>}
<h3 class="view-transition-title" style={`--title-view-transition-name: article-title-${getEntrySlug(article)}`}><a href={withBase(`/articles/${getEntrySlug(article)}/`)}>{article.data.title}<span class="note-arrow"><GroundArrow/></span></a></h3><p>{article.data.description}</p>
</article>)}</div><p class="writing-index-empty" data-writing-empty hidden>No notes in this topic yet.</p><a class="chapter-link" href={withBase('/articles/')}>All writing <span><GroundArrow/></span></a>
</section>
<section class="ground-work" id="work" aria-labelledby="work-title"><header class="chapter-heading"><div><h2 id="work-title"><em>Experiments</em></h2></div></header>
<div class="workbench"><div class="workbench-art"><img src={withBase('/ground/workshop.webp')} width="1536" height="1024" alt="Terracotta arch, cobalt slab, and yellow cylinder arranged into an architectural sculpture" loading="lazy"/></div><div class="work-entries">{projects.map((project,i)=><details class="work-entry" open={i===0}><summary><span class="micro">0{i+1}</span><h3>{project.data.title}</h3><span class="entry-toggle" aria-hidden="true">+</span></summary><div class="work-detail"><p>{project.data.description}</p><a href={withBase(`/work/${getEntrySlug(project)}/`)}>Read project</a>{project.data.repoUrl&&<a href={project.data.repoUrl} target="_blank" rel="noreferrer">Source</a>}</div></details>)}</div></div><a class="chapter-link" href={withBase("/work/")}>All experiments <GroundArrow/></a>
</section>
<section class="ground-about" id="about" aria-labelledby="about-title"><div class="about-symbol" aria-hidden="true"><span>h</span><span>m</span></div><div class="about-copy"><h2 id="about-title">About <em>me</em></h2><p>My background spans QA, product management, and technical program management. This site is where I share my writing and experiments.</p><a class="chapter-link" href={withBase('/resume/')}>A little more about me</a></div></section>

<script is:inline src={withBase('/vendor/gsap/gsap.min.js')}></script>
<script is:inline src={withBase('/vendor/gsap/ScrollTrigger.min.js')}></script>
<script is:inline src={withBase('/ground/score.js')}></script>
<script is:inline src={withBase('/ground/site.js')}></script>
</BaseLayout>
