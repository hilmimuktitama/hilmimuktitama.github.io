---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEntrySlug } from "../../lib/content";
import { withBase } from "../../lib/urls";

const projects = (await getCollection("projects"))
  .filter((project) => project.data.status === "public")
  .sort((a, b) => a.data.order - b.data.order);

const formatDate = (date?: Date) =>
  date?.toLocaleDateString("en", { month: "short", year: "numeric" }) ?? "Ready for update";

const formatProjectStatus = (source: "github" | "manual") =>
  source === "github" ? "public repo" : "case note";
---

<BaseLayout title="Case Studies" description="Public repository-backed projects for Technical Program Manager work by Hilmi Muktitama.">
  <section class="section page-intro" aria-labelledby="work-title">
    <div class="section-aside">
      <p class="eyebrow">Selected work</p>
      <p class="section-number" aria-hidden="true">02</p>
    </div>
    <div class="page-intro-main">
      <div class="page-intro-body">
        <h1 id="work-title">Execution systems with public repositories.</h1>
        <p class="lede">Projects across delivery planning, source-backed reporting, and reviewable workflow design.</p>
        <p class="page-note">Each entry starts with an operating problem, then shows what changed and what evidence is safe to inspect.</p>
      </div>
      <div class="work-index-list">
        {projects.map((project, index) => (
          <article class={`project-index-item ${project.data.featured ? "is-featured" : ""}`}>
            <span class="item-index">{String(index + 1).padStart(2, "0")}</span>
            <div class="project-index-title">
              <p class="item-meta"><span>{project.data.kind === "flagship" ? "Flagship" : project.data.kind === "component" ? "Component" : "Project"}</span><span>{formatDate(project.data.updatedDate)}</span></p>
              <h2><a href={withBase(`/work/${getEntrySlug(project)}/`)}>{project.data.title}</a></h2>
              <div class="tag-row">
                <span class="tag">{formatProjectStatus(project.data.source)}</span>
                {project.data.language && <span class="tag">{project.data.language}</span>}
              </div>
            </div>
            <p class="project-desc">{project.data.description}</p>
            <div class="project-actions">
              <a class="row-action" href={withBase(`/work/${getEntrySlug(project)}/`)} aria-label={`Read ${project.data.title} case study`}>Read case study <span aria-hidden="true">↗</span></a>
              {project.data.repoUrl && <a class="external-link" href={project.data.repoUrl} target="_blank" rel="noreferrer">Repository</a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
