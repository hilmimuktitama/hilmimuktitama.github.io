{
  "name": "web-profile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "verify:site": "node scripts/verify-site.mjs",
    "test:e2e": "npm run build && npm run test:e2e:run",
    "test:e2e:run": "playwright test --project=chromium",
    "test:e2e:update": "npm run build && playwright test --project=chromium --update-snapshots",
    "test:e2e:cross-browser": "npm run build && playwright test --project=firefox --project=webkit --grep-invert screenshot",
    "verify": "npm run build && npm run verify:site && npm run test:e2e:run"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-satteri": "0.3.5",
    "@phosphor-icons/web": "^2.1.2",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "7.2.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^26.4.1"
  }
}
