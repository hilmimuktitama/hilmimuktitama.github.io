---
import "../styles/global.css";
import { GITHUB_URL, LINKEDIN_URL, withBase } from "../lib/urls";

interface Props {
  title?: string;
  description?: string;
  showContactFooter?: boolean;
  ogType?: "website" | "article";
  ogImage?: string;
  publishedTime?: string | Date;
  modifiedTime?: string | Date;
  tags?: string[];
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "Hilmi Muktitama",
  description = "Senior Technical Program Manager focused on B2B SaaS platform delivery, customer data, AI automation, rollout readiness, and source-backed program execution.",
  showContactFooter = true,
  ogType = "website",
  ogImage,
  publishedTime,
  modifiedTime,
  tags = [],
  structuredData
} = Astro.props;

const pageTitle = title === "Hilmi Muktitama" ? title : `${title} | Hilmi Muktitama`;
const site = Astro.site ?? new URL("https://hilmimuktitama.github.io");
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const resolveSiteUrl = (value: string) => {
  try {
    return new URL(value).toString();
  } catch {
    return new URL(withBase(value.startsWith("/") ? value : `/${value}`), site).toString();
  }
};
const shareImageUrl = resolveSiteUrl(ogImage ?? "/og-image.png");
const toIsoString = (value?: string | Date) =>
  value instanceof Date ? value.toISOString() : value;
const publishedTimeIso = toIsoString(publishedTime);
const modifiedTimeIso = toIsoString(modifiedTime);
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replace(/[<>&]/g, (character) => {
      if (character === "<") return "\\u003c";
      if (character === ">") return "\\u003e";
      return "\\u0026";
    })
  : undefined;
const pathname = Astro.url.pathname;
const isCurrent = (path: string) => pathname.startsWith(withBase(path));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {ogType === "article" && publishedTimeIso && <meta property="article:published_time" content={publishedTimeIso} />}
    {ogType === "article" && modifiedTimeIso && <meta property="article:modified_time" content={modifiedTimeIso} />}
    {ogType === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageUrl} />
    <script is:inline>
      (() => {
        const themeKey = "theme";
        const root = document.documentElement;
        const systemTheme = () =>
          window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        try {
          const storedTheme = localStorage.getItem(themeKey);
          root.dataset.theme =
            storedTheme === "dark" || storedTheme === "light" ? storedTheme : systemTheme();
        } catch {
          root.dataset.theme = systemTheme();
        }
      })();
    </script>
    <title>{pageTitle}</title>
    {structuredDataJson && <script is:inline type="application/ld+json" set:html={structuredDataJson} />}
  </head>
  <body>
    <div class="site-shell">
      <a class="skip-link" href="#main-content">Skip to main content</a>
      <header class="site-header">
        <div class="site-header-inner">
          <a class="brand" href={withBase("/")} aria-label="Hilmi Muktitama home">
            <span class="brand-mark">HM</span>
            <span class="brand-copy">
              <span class="brand-name">Hilmi Muktitama</span>
              <span class="brand-role">Technical Program Manager</span>
            </span>
          </a>
          <nav class="site-nav" aria-label="Primary navigation">
            <a href={withBase("/work/")} aria-current={isCurrent("/work/") ? "page" : undefined}>Work</a>
            <a href={withBase("/articles/")} aria-current={isCurrent("/articles/") ? "page" : undefined}>Writing</a>
            <a href={withBase("/resume/")} aria-current={isCurrent("/resume/") ? "page" : undefined}>Resume</a>
            <a href={withBase("/contact/")} aria-current={isCurrent("/contact/") ? "page" : undefined}>Contact</a>
          </nav>
          <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="Switch to dark mode">
            <span class="theme-icon" aria-hidden="true">◐</span>
            <span data-theme-toggle-value>Light</span>
          </button>
        </div>
      </header>
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      {showContactFooter && (
        <footer class="site-footer" id="contact">
          <div class="footer-mark" aria-hidden="true">HM</div>
          <div class="footer-intro">
            <p class="footer-kicker">A working notebook by Hilmi Muktitama.</p>
            <p class="muted">Program clarity, technical judgment, and the work between a decision and a release.</p>
          </div>
          <div class="footer-cta">
            <p class="footer-kicker">Have a difficult program to move?</p>
            <a href={withBase("/contact/")}>Let's talk <span aria-hidden="true">↗</span></a>
          </div>
          <div class="footer-links" aria-label="Contact links">
            <a href="mailto:hilmimukti@gmail.com">hilmimukti@gmail.com</a>
            <a class="external-link" href={LINKEDIN_URL} target="_blank" rel="noreferrer">LinkedIn</a>
            <a class="external-link" href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
          </div>
        </footer>
      )}
    </div>
    <script is:inline>
      (() => {
        const themeKey = "theme";
        const root = document.documentElement;
        const toggle = document.querySelector("[data-theme-toggle]");
        const toggleValue = document.querySelector("[data-theme-toggle-value]");
        const media = window.matchMedia("(prefers-color-scheme: dark)");

        if (!(toggle instanceof HTMLButtonElement) || !toggleValue) return;

        const getStoredTheme = () => {
          try {
            const storedTheme = localStorage.getItem(themeKey);
            return storedTheme === "dark" || storedTheme === "light" ? storedTheme : null;
          } catch {
            return null;
          }
        };

        const getSystemTheme = () => (media.matches ? "dark" : "light");
        const getActiveTheme = () => getStoredTheme() ?? getSystemTheme();

        const applyTheme = (theme) => {
          root.dataset.theme = theme;
          toggle.setAttribute("aria-pressed", String(theme === "dark"));
          toggle.setAttribute(
            "aria-label",
            `Switch to ${theme === "dark" ? "light" : "dark"} mode`
          );
          toggleValue.textContent = theme === "dark" ? "Dark" : "Light";
        };

        applyTheme(getActiveTheme());

        toggle.addEventListener("click", () => {
          root.dataset.themeChanging = "true";
          const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
          try {
            localStorage.setItem(themeKey, nextTheme);
          } catch {
            root.dataset.theme = nextTheme;
          }
          applyTheme(nextTheme);
          window.setTimeout(() => delete root.dataset.themeChanging, 220);
        });

        media.addEventListener("change", () => {
          if (!getStoredTheme()) applyTheme(getSystemTheme());
        });
      })();
    </script>
  </body>
</html>
