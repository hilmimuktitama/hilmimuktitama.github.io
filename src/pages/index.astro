---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntrySlug } from "../lib/content";
import { GITHUB_URL, LINKEDIN_URL, withBase } from "../lib/urls";

const projects = (await getCollection("projects"))
  .filter((project) => project.data.status === "public")
  .sort((a, b) => a.data.order - b.data.order);
const visibleProjects = projects.slice(0, 3);

const now = Date.now();

const articles = (await getCollection("articles"))
  .filter((article) => article.data.pubDate.valueOf() <= now)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const formatDate = (date?: Date) =>
  date?.toLocaleDateString("en", { month: "short", year: "numeric", timeZone: "Asia/Jakarta" }) ??
  "Ready for update";
---

<BaseLayout>
  <section class="section hero" aria-labelledby="hero-title">
    <div class="hero-identity">
      <p class="eyebrow">Hilmi Muktitama · Senior Technical Program Manager</p>
      <h1 id="hero-title">Complex programs, made ready to ship.</h1>
    </div>
    <div class="hero-copy">
      <p class="lede">
        I turn cross-squad platform and automation programs into source-backed plans, clear decisions, and release-ready work.
      </p>
      <div class="proof-grid" aria-label="Experience highlights">
        <div><strong>5+ years</strong><span>across program, product, and QA</span></div>
        <div><strong>Senior TPM</strong><span>leading B2B SaaS delivery at Mekari</span></div>
        <div><strong>20+ clients</strong><span>supported through API integration</span></div>
      </div>
      <div class="link-row" aria-label="Primary profile links">
        <a class="button-link primary" href={withBase("/work/")}>Read my work</a>
        <a class="button-link" href={withBase("/resume/")}>View resume</a>
      </div>
      <div class="quiet-links" aria-label="External profile links">
        <a href={withBase("/contact/")}>Contact</a>
        <a class="external-link" href={LINKEDIN_URL} target="_blank" rel="noreferrer">LinkedIn</a>
        <a class="external-link" href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
      </div>
    </div>
  </section>

  <section class="section" id="case-studies" aria-labelledby="case-studies-title">
    <div class="section-heading">
      <p class="eyebrow">Selected Work</p>
      <div>
        <h2 id="case-studies-title">Systems that make delivery evidence visible.</h2>
        <p>Public work showing how I turn ambiguous inputs into reviewable execution artifacts.</p>
      </div>
    </div>
    <div class="featured-work">
      {visibleProjects.map((project, index) => (
        <a class={`work-card ${index === 0 ? "lead" : ""}`} href={withBase(`/work/${getEntrySlug(project)}/`)}>
          <div class="work-card-meta"><span>{index === 0 ? "Featured case study" : "Case study"}</span><span>{formatDate(project.data.updatedDate)}</span></div>
          <h3>{project.data.title}</h3>
          <p>{project.data.description}</p>
          <span class="card-action">Read case study <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
    <p class="inline-action"><a href={withBase("/work/")}>View all work</a></p>
  </section>

  <section class="section" id="articles" aria-labelledby="articles-title">
    <div class="section-heading">
      <p class="eyebrow">Writing</p>
      <div>
        <h2 id="articles-title">Notes from inside software delivery.</h2>
        <p>Practical writing on AI tooling, technical judgment, and the habits behind reliable execution.</p>
      </div>
    </div>
    {articles.length > 0 ? (
      <div class="article-grid">
        {articles.map((article) => (
          <a class="article-card" href={withBase(`/articles/${getEntrySlug(article)}/`)}>
            <p class="meta">{formatDate(article.data.pubDate)}</p>
            <h3>{article.data.title}</h3>
            <p>{article.data.description}</p>
          </a>
        ))}
      </div>
      <p class="inline-action"><a href={withBase("/articles/")}>View all writing</a></p>
    ) : (
      <p class="empty-note">Writing will appear here once there is something useful to share.</p>
    )}
  </section>

  <section class="section" id="resume" aria-labelledby="resume-title">
    <div class="section-heading">
      <p class="eyebrow">Resume</p>
      <div>
        <h2 id="resume-title">A path from testing systems to leading them.</h2>
        <p>QA engineering built the technical instinct. Product management added customer and platform ownership. Technical program management brought both into cross-squad execution.</p>
      </div>
    </div>
    <div class="career-path" aria-label="Career progression">
      <div><span>2019</span><strong>Quality Assurance</strong></div>
      <div><span>2020</span><strong>Product Management</strong></div>
      <div><span>2022—now</span><strong>Technical Program Management</strong></div>
    </div>
    <p class="inline-action"><a href={withBase("/resume/")}>View full resume</a></p>
  </section>
</BaseLayout>
